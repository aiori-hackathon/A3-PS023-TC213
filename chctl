#!/usr/bin/env python3
import sys
import os
import json
import argparse
import httpx

CONTROLLER_URL = os.getenv("CONTROLLER_URL", "http://localhost:8000")
ADMIN_TOKEN = os.getenv("CONTROLLER_API_KEY", "default-admin-token")
HEADERS = {"Authorization": f"Bearer {ADMIN_TOKEN}"}

def run_request(method: str, path: str, json_data=None):
    url = f"{CONTROLLER_URL}{path}"
    try:
        with httpx.Client(timeout=10.0) as client:
            resp = client.request(method, url, headers=HEADERS, json=json_data)
            if resp.headers.get("content-type", "").startswith("text/plain"):
                print(resp.text)
                return
            try:
                data = resp.json()
                print(json.dumps(data, indent=2))
            except Exception:
                print(resp.text)
    except httpx.ConnectError:
        print(f"[!] Error: Controller not reachable at {CONTROLLER_URL}. Ensure controller is running.")
        sys.exit(1)
    except Exception as e:
        print(f"[!] Error: {e}")
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(prog="chctl", description="AIORI PS-023 Cloud Hypervisor Cluster Control CLI")
    subparsers = parser.add_subparsers(dest="resource", help="Target resource")

    # Node commands
    node_parser = subparsers.add_parser("nodes", help="Node management")
    node_sub = node_parser.add_subparsers(dest="action")
    node_sub.add_parser("list", help="List all cluster worker nodes")

    # VM commands
    vm_parser = subparsers.add_parser("vm", help="MicroVM management")
    vm_sub = vm_parser.add_subparsers(dest="action")
    
    vm_sub.add_parser("list", help="List active cluster microVMs")

    spawn_p = vm_sub.add_parser("spawn", help="Provision a new microVM")
    spawn_p.add_argument("--name", required=True, help="VM workload name")
    spawn_p.add_argument("--vcpus", type=int, default=1, help="vCPU count (1-4)")
    spawn_p.add_argument("--memory", type=int, default=512, help="RAM in MB (128-2048)")

    start_p = vm_sub.add_parser("start", help="Start a stopped microVM")
    start_p.add_argument("vm_id", help="Target VM ID")

    stop_p = vm_sub.add_parser("stop", help="Stop a running microVM")
    stop_p.add_argument("vm_id", help="Target VM ID")

    del_p = vm_sub.add_parser("delete", help="Terminate and delete a microVM")
    del_p.add_argument("vm_id", help="Target VM ID")

    # Metrics command
    subparsers.add_parser("metrics", help="Expose live Prometheus metrics")

    args = parser.parse_args()

    if args.resource == "nodes":
        if args.action == "list" or not args.action:
            run_request("GET", "/api/v1/nodes")
    elif args.resource == "vm":
        if args.action == "list" or not args.action:
            run_request("GET", "/api/v1/vms")
        elif args.action == "spawn":
            payload = {"name": args.name, "vcpus": args.vcpus, "memory_mb": args.memory}
            run_request("POST", "/api/v1/vms", json_data=payload)
        elif args.action == "start":
            run_request("POST", f"/api/v1/vms/{args.vm_id}/start")
        elif args.action == "stop":
            run_request("POST", f"/api/v1/vms/{args.vm_id}/stop")
        elif args.action == "delete":
            run_request("DELETE", f"/api/v1/vms/{args.vm_id}")
    elif args.resource == "metrics":
        run_request("GET", "/api/v1/metrics")
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
